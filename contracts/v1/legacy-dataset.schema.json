            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrency": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "intended": {
          "$ref": "#/$defs/placement"
        },
        "observed": {
          "$ref": "#/$defs/placement"
        },
        "compatibility": {
          "enum": [
            "known",
            "uncertain"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "pending",
            "withdrawn",
            "held"
          ]
        },
        "status_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
