            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        }
      },
      "required": [
        "id",
        "family_id",
        "name",
        "description",
        "group",
        "metric",
        "metric_kind",
        "scoring",
        "source",
        "selection_revision",
        "scorer_revision",
        "question_ids",
        "primary_question_ids",
        "exclusions"
      ]
