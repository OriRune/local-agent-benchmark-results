        "id",
        "artifact_id",
        "name",
        "runtime",
        "runtime_build",
        "template_override_id",
        "tool_adapter",
        "hardware_id",
        "concurrency",
        "intended",
        "observed",
        "compatibility",
        "status",
        "status_reason"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "configuration_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "reasoning_requested": {
          "enum": [
            "on",
            "off"
          ]
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "verified",
            "cannot_disable",
            "ignored_switch",
            "no_reasoning_observed",
            "inconclusive",
            "unknown"
          ]
        },
        "probe_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
