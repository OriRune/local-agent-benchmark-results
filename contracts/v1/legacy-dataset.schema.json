        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weight_file"
          }
        },
        "total_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance_status": {
          "enum": [
            "verified",
            "recorded_source",
            "legacy_partial",
            "unresolved"
          ]
        }
      },
      "required": [
        "id",
        "checkpoint_id",
        "quantization",
        "publisher",
        "repository",
        "revision",
        "files",
        "total_bytes",
        "template_id",
        "provenance_status"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_layers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_moe_layers": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "threads": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "context",
        "gpu_layers",
        "cpu_moe_layers",
