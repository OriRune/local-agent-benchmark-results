---
import '../styles/global.css';
import ThemeSelect from '../components/ThemeSelect.astro';
const { title = 'Agent benchmark results' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Recorded results from local language models: task scores, thinking tradeoffs, and exact available evidence."/><script is:inline>try { const theme = localStorage.getItem('agentbench-theme'); if (['light', 'dark', 'system'].includes(theme)) document.documentElement.dataset.theme = theme; } catch {}</script><title>{title} · Agent Bench</title></head><body><a class="skip" href="#main">Skip to results</a><header class="masthead"><div class="wrap"><a class="brand" href="/">Agent<span>Bench</span> <small> / results</small></a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/models/">Models</a><a href="/tests/">The tests</a><a href="/methodology/">Methodology</a><a href="/editions/">Editions</a></nav><ThemeSelect/></div></header><main id="main" class="wrap" tabindex="-1"><slot/></main><footer><div class="wrap">Small, transparent test banks. Results describe these measured setups—not general model ability. <a href="/methodology/">How to read the results</a></div></footer></body></html>
