---
import Shell from '../layouts/Shell.astro';import{currentData,retainedEditions,withdrawnEditions}from'../lib/data';import{archiveUrl}from'../lib/edition-client';const editions=await retainedEditions();const withdrawn=await withdrawnEditions();const{release,index}=await currentData();const object=release.objects.find(o=>o.id===release.dataset_object_id)!;
---
<Shell title="Results editions"><div class="eyebrow">Versioned and inspectable</div><h1>A result should<br/>keep its context.</h1><p class="lede">Editions bind results, evidence and approved analysis together. Pinned comparisons identify the exact edition rather than silently switching to newer scores.</p><section class="panel"><h2>Current edition</h2><p><code style="overflow-wrap:anywhere">{release.release_id}</code></p><p>Campaign began {index.campaign_created_at}. This is a captured results edition, not a live harness connection.</p><p><a href={`/data/${object.path}`} download>Download complete public facts (gzip JSON)</a> · <a href={`/data/releases/${release.release_id}/release.json`}>Release manifest and checksums</a></p><p><a href="/results.csv" download>Download aggregate results (CSV)</a></p><p class="footnote">CSV contains aggregate metadata and measurements only. Text cells that could be interpreted as spreadsheet formulas receive a leading apostrophe; JSON and exact evidence downloads preserve their permitted bytes.</p><p class="footnote">The full data download is intentionally large. Individual model and question pages load their own evidence as needed.</p></section><section class="panel"><h2>Retained editions</h2><ul>{editions.map(edition=><li><a style="overflow-wrap:anywhere" href={archiveUrl(edition.release_id)}>{edition.release_id}</a>{edition.release_id===release.release_id?' · Current':''}<p>{edition.changes.description}</p></li>)}</ul></section><section class="panel"><h2>Withdrawn editions</h2>{withdrawn.length?<ul>{withdrawn.map(([id,notice])=><li><a style="overflow-wrap:anywhere" href={archiveUrl(id)}>{id}</a><p>{notice.withdrawn_at.slice(0,10)} · {notice.reason}</p></li>)}</ul>:<p>No editions have been withdrawn.</p>}</section><section class="panel"><h2>Recorded amendments</h2>{index.amendments.length?index.amendments.map(a=><article><h3>{a.kind.replaceAll('_',' ')} · {a.id}</h3><p>{a.description}</p></article>):<p>No amendments recorded for this edition.</p>}</section></Shell>
