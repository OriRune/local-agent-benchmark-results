---
import TestExplanation from '../../components/TestExplanation';
import Shell from '../../layouts/Shell.astro';import{currentData,questionData}from'../../lib/data';import EvidenceViewer from'../../components/EvidenceViewer';import QuestionAnswers from'../../components/QuestionAnswers';
export async function getStaticPaths(){const{index}=await currentData();return index.questions.map(q=>({params:{question:q.id}}));}
const {index}=await currentData();const data=await questionData(Astro.params.question!);const q=data.question;const suite=index.suites.find(s=>s.id===q.suite_id)!;
---
<Shell title={`${q.source_id} · ${suite.name}`}><a href={`/tests/${suite.id}/`}>← {suite.name}</a><div class="eyebrow" style="margin-top:28px">Exact available evidence</div><h1>{index.test_descriptions?.questions[q.id]?.title ?? q.source_id}</h1><p class="lede">{q.source_id} · {q.title} · <span class="badge">{q.scoring_status}</span></p><section class="panel"><TestExplanation heading="What this task tests" explanation={index.test_descriptions?.questions[q.id]}/><h2>The question</h2><EvidenceViewer component={q.components.prompt} objects={data.objects} label="Question" auto client:load/><details><summary>Supplied context</summary><EvidenceViewer component={q.components.context} objects={data.objects} label="Context" client:load/></details><details><summary>Reveal reference answers and checks</summary><EvidenceViewer component={q.components.reference} objects={data.objects} label="Reference answers" client:load/><EvidenceViewer component={q.components.checks} objects={data.objects} label="Reference checks" client:load/></details>{q.branches.map(b=><details><summary>{b.name}</summary><EvidenceViewer component={b.prompt} objects={data.objects} label={b.name} client:load/><EvidenceViewer component={b.reference} objects={data.objects} label="Branch reference" client:load/></details>)}<p class="footnote">{q.source.attribution} {q.source.url&&<a href={q.source.url}>Source</a>}</p></section><QuestionAnswers data={data} index={index} client:load/></Shell>
