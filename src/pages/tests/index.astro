---
import EvidenceAvailability from '../../components/EvidenceAvailability.astro';
import Shell from '../../layouts/Shell.astro';import{currentData}from'../../lib/data';const{index}=await currentData();
const groups=[['coding','Coding & tools'],['reasoning','Reasoning'],['instructions','Instructions'],['reading','Reading & evidence'],['corrections','Corrections']];
---
<Shell title="Inside the tests"><div class="eyebrow">Questions, checks and sources</div><h1>Know what a score<br/>actually measures.</h1><p class="lede">These are small, fixed test banks. Capability groups help you navigate; they are never combined into a single overall score.</p><div>{groups.map(([id,name])=><section><h2>{name}</h2><div class="grid">{index.suites.filter(s=>s.group===id).map(s=><article class="card"><span class="eyebrow">{s.group}</span><h3><a href={`/tests/${s.id}/`}>{s.name}</a></h3><p>{s.description}</p><p><strong>{s.primary_question_ids.length}</strong> primary questions · {s.metric}</p><small>{s.scoring}</small><EvidenceAvailability availability={index.availability} suiteId={s.id}/></article>)}</div></section>)}</div></Shell>
