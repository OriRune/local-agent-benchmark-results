---
import EvidenceAvailability from '../../components/EvidenceAvailability.astro';
import {suiteLabel} from '../../lib/suite-label';
import Shell from '../../layouts/Shell.astro';import{currentData}from'../../lib/data';const{index}=await currentData();
const groups=[['coding','Coding & tools'],['reasoning','Reasoning'],['instructions','Instructions'],['reading','Reading & evidence'],['corrections','Corrections']];
---
<Shell title="Inside the tests"><h1>Tests &amp; questions</h1><p class="lede">These are small, fixed test banks. Capability groups help you navigate. The <a href="/heatmap/">heatmap</a> also shows a balanced index that weights each of the nine task categories equally; individual test scores and coverage remain visible.</p><div>{groups.map(([id,name])=><section><h2>{name}</h2><div class="grid">{index.suites.filter(s=>s.group===id).map(s=><article class="card"><span class="eyebrow">{s.group}</span><h3><a href={`/tests/${s.id}/`}>{suiteLabel(index,s)}</a></h3><p>{s.description}</p><p><strong>{s.primary_question_ids.length}</strong> primary questions · {s.metric}</p><p><a href={`/?suite=${s.id}`}>See model results →</a></p><details><summary>Scoring method</summary><p class="footnote">{s.scoring}</p></details><EvidenceAvailability availability={index.availability} suiteId={s.id}/></article>)}</div></section>)}</div></Shell>
