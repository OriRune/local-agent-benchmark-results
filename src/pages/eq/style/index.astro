---
import Frame from '../../../components/eq/Frame.astro';
import { data } from '../../../data/eq-data';
import { groups } from '../../../data/eq-traits';
---
<Frame title="Conversational style"><h1>Conversational style</h1><p class="lede">How models tend to respond across conversations.</p><p class="notice">These are style tendencies, not quality scores: higher is not better. They use the upstream traits rubric and are not part of the rating.</p><p>Each score is a mean from 0 to 10, averaged across conversations. Both judges assess each conversation. Partial results are marked in progress.</p><p class="footnote">Open a model for detailed style profiles and uncertainty intervals.</p>{groups.map(g=><section><h2>{g.name}</h2><div class="table-scroll" tabindex="0" role="region" aria-label={g.name}><table class="board"><thead><tr><th>Model</th>{g.traits.map(([,label])=><th>{label}</th>)}<th>Coverage</th></tr></thead><tbody>{data.models.map(m=><tr><td><a href={`/eq/models/${m.id}/`}>{m.name}</a></td>{g.traits.map(([key,label])=><td data-label={label}>{m.traits?.[key]?.mean.toFixed(1) ?? '—'}</td>)}<td data-label="Coverage">{m.traits_valid ?? 0}/{m.traits_planned ?? m.planned * data.judges.length} {((m.traits_valid ?? 0) < (m.traits_planned ?? m.planned * data.judges.length)) ? '· In progress' : ''}</td></tr>)}</tbody></table></div></section>)}</Frame>
