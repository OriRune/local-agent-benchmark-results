---
import Frame from '../../../components/eq/Frame.astro';
import { data } from '../../../data/eq-data';
import { traits } from '../../../data/eq-traits';
export function getStaticPaths(){return data.conversations.map(conversation=>({params:{id:conversation.id},props:{conversation}}));}
const { conversation:c }=Astro.props;
const model=data.models.find(m=>m.id===c.model);
const persona=data.persona_cards.find(p=>p.id===c.scenario_id);
---
<Frame title={c.scenario}><p><a href={`/eq/models/${c.model}/`}>← {model?.name}</a></p><h1>{c.scenario}</h1><p class="muted">{c.status.replaceAll('_',' ')} · Partner: {data.partner}</p>{c.scenario_id && <p><a href={`/eq/personas/#${c.scenario_id}`}>View persona and initial instructions</a></p>}
{c.retry && <p class="notice"><strong>{c.retry.state === 'queued' ? 'Retry queued' : 'Retried conversation'}</strong> · The earlier {c.retry.reason}. {c.retry.completed_turns_before_retry} completed turns were kept. This label does not affect scoring.</p>}
{persona && <details class="conversation-context"><summary>About this persona · {persona.category_label}</summary><p>{persona.summary}</p><p class="footnote">{persona.category_description} This background was hidden from the tested model.</p></details>}
<section class="chat-window" aria-label="Conversation"><header class="chat-header"><span class="chat-avatar" aria-hidden="true">EQ</span><div><strong>{model?.name}</strong><small>Conversation with a simulated person</small></div><span class="badge">{c.status.replaceAll('_',' ')}</span></header><div class="chat-messages">
{c.opening && <article class="message user opening"><div class="message-author">Simulated person · <span>Opening</span></div><div class="message-bubble"><p>{c.opening}</p></div></article>}
{c.transcript.map((msg,i)=><article class={`message ${msg.role}`}><div class="message-author">{msg.role==='user' ? 'Simulated person' : model?.name}<span class="message-number">{i+1}</span></div><div class="message-bubble"><p>{msg.content}</p></div>{msg.thinking && <details class="message-thinking"><summary>{msg.thinking_kind==='persona_monologue' ? 'Persona inner monologue' : 'Model thinking'} · expand</summary><p class="thinking-note">{msg.thinking_kind==='persona_monologue' ? 'Simulated character narration, hidden from the tested model. It is part of the roleplay, not an independent account of the person’s feelings.' : 'Recorded model reasoning, separate from the spoken reply. Availability varies by model and provider.'}</p><div class="thinking-text">{msg.thinking}</div></details>}</article>)}
</div><p class="chat-footnote">Thinking is shown only where it was recorded. An absent expander does not mean the model did not reason.</p></section>
<section class="panel"><h2>Conversational style</h2><p>Style tendencies, not quality scores; higher is not better. These do not affect ratings.</p>{!(c.traits?.length) && <p>In progress.</p>}{c.traits?.map(r=><div><h3>{r.judge}</h3><ul>{traits.map(([key,label])=><li>{label}: {r.scores[key] ?? '—'}</li>)}</ul></div>)}</section><section class="panel"><h2>Judge verdicts</h2>{c.verdicts.length===0 && <p>No judgments yet.</p>}{c.verdicts.map(v=><details class="verdict"><summary>{v.judge} · {v.order} · {v.status}</summary><p>{v.model_a} vs {v.model_b}: {v.outcome_for_a == null ? 'no verdict' : v.outcome_for_a === 1 ? `${v.model_a} wins` : v.outcome_for_a === 0 ? `${v.model_b} wins` : 'tie'}</p><ul>{Object.entries(v.dimensions).map(([d,w])=><li>{d.replaceAll('_',' ')}: {w.winner} (margin {w.margin})</li>)}</ul></details>)}</section></Frame>
