---
import Frame from '../../../components/eq/Frame.astro';
import { data } from '../../../data/eq-data';
import { traits } from '../../../data/eq-traits';
export function getStaticPaths(){return data.conversations.map(conversation=>({params:{id:conversation.id},props:{conversation}}));}
const { conversation:c }=Astro.props;
const model=data.models.find(m=>m.id===c.model);
---
<Frame title={c.scenario}><p><a href={`/eq/models/${c.model}/`}>← {model?.name}</a></p><h1>{c.scenario}</h1><p class="muted">{c.status.replaceAll('_',' ')} · Partner: {data.partner}</p>{c.scenario_id && <p><a href={`/eq/personas/#${c.scenario_id}`}>View persona and initial instructions</a></p>}{c.opening && <article class="card chat muted"><strong>Opening</strong><p>{c.opening}</p></article>}{c.transcript.map(msg=><article class={`card chat ${msg.role}`}><strong>{msg.role==='user' ? 'Simulated person' : model?.name}</strong><p>{msg.content}</p></article>)}<section class="panel"><h2>Conversational style</h2><p>Style tendencies, not quality scores; higher is not better. These do not affect ratings.</p>{!(c.traits?.length) && <p>In progress.</p>}{c.traits?.map(r=><div><h3>{r.judge}</h3><ul>{traits.map(([key,label])=><li>{label}: {r.scores[key] ?? '—'}</li>)}</ul></div>)}</section><section class="panel"><h2>Judge verdicts</h2>{c.verdicts.length===0 && <p>No judgments yet.</p>}{c.verdicts.map(v=><div><h3>{v.judge} · {v.order}</h3><p>{v.status} · {v.model_a} vs {v.model_b}: {v.outcome_for_a == null ? 'no verdict' : v.outcome_for_a === 1 ? `${v.model_a} wins` : v.outcome_for_a === 0 ? `${v.model_b} wins` : 'tie'}</p><ul>{Object.entries(v.dimensions).map(([d,w])=><li>{d.replaceAll('_',' ')}: {w.winner} (margin {w.margin})</li>)}</ul></div>)}</section></Frame>
