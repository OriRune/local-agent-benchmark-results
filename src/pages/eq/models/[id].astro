---
import Frame from '../../../components/eq/Frame.astro';
import Metric from '../../../components/eq/Metric.astro';
import Radar from '../../../components/eq/Radar.astro';
import {mean, type RadarAxis} from '../../../lib/eq-radar';
import {data} from '../../../data/eq-data';
import {groups} from '../../../data/eq-traits';
import definitions from '../../../data/eq-definitions.json';
export function getStaticPaths(){return data.models.map(model=>({params:{id:model.id},props:{model}}));}
const {model}=Astro.props;
const conversations=data.conversations.filter(c=>c.model===model.id);
const labels:Record<string,string>={bond_and_rapport:'Bond & rapport',authenticity:'Authenticity',attunement:'Attunement',meeting_prefs_and_needs:'Preferences & needs',emotion_sensemaking:'Emotion sensemaking',emotion_management:'Emotion management'};
const def=(k:string)=>(definitions as Record<string,string>)[k] ?? k;
const plots=data.judges.map(j=>{const points=data.models.filter(m=>m.per_judge[j.id]!=null).map(m=>({id:m.id,name:m.name,value:m.per_judge[j.id]!})).sort((a,b)=>a.value-b.value);return {judge:j,points};});
const ratings=plots.flatMap(p=>p.points.map(x=>x.value));
const low=Math.floor((Math.min(...ratings,900)-30)/50)*50,high=Math.ceil((Math.max(...ratings,1200)+30)/50)*50;
const pos=(n:number)=>(n-low)/(high-low)*100;
const shortLabels:Record<string,string[]>={bond_and_rapport:['Bond &','rapport'],authenticity:['Authenticity'],attunement:['Attunement'],meeting_prefs_and_needs:['Preferences','& needs'],emotion_sensemaking:['Emotion','sensemaking'],emotion_management:['Emotion','management'],challenge_propensity:['Pushback'],yielding_propensity:['Yields under','pressure'],frame_capture:['Frame capture'],validation_propensity:['Validation'],boundary_setting:['Boundary','setting'],analytical:['Analytical'],interpretive_boldness:['Interpretive','boldness'],clinical_register_propensity:['Clinical','register'],directive_advice_orientation:['Directive','advice'],escalation_containment:['Escalation','containment'],native_frame_adaptation:['Frame','adaptation'],naturalness_authenticity:['Naturalness']};
const abilityAxes=data.dimensions.map(key=>({key,label:labels[key] ?? key,shortLabel:shortLabels[key] ?? [key]}));
const radarData=(axes:RadarAxis[],style=false)=>{
  const values=(m:typeof model)=>axes.map(a=>(style ? m.traits?.[a.key]?.mean : m.abilities[a.key]) ?? null);
  return {subject:{id:model.id,label:model.name,values:values(model)},comparisons:[{id:'field-mean',label:'Scored-model mean',values:axes.map(a=>mean(data.models.map(m=>style ? m.traits?.[a.key]?.mean : m.abilities[a.key])))},...data.models.filter(m=>m.id!==model.id && values(m).some(v=>v!=null)).map(m=>({id:m.id,label:m.name,values:values(m)}))]};
};
const completion=model.completion;
const ready=completion?.summary_status==='ready_for_summary';
const opponents=Object.entries(model.record).sort((a,b)=>(b[1].won+b[1].tied+b[1].lost)-(a[1].won+a[1].tied+a[1].lost));
---
<Frame title={model.name}>
<p><a href="/eq/">← Leaderboard</a></p><h1>{model.name}</h1>
<p><span class="badge">{model.kind}</span> {model.quant} {model.size} {model.thinking==null ? '' : `· Thinking ${model.thinking ? 'on' : 'off'}`}</p>
<div class="eq-summary">
<div><span class="muted">Combined rating</span><strong>{model.comparisons>=4 && model.rating!=null ? model.rating.toFixed(1) : 'In progress'}</strong><small>{model.ci ? `95% interval ${model.ci.map(v=>v.toFixed(1)).join('–')}` : 'Not enough judgments yet'}</small></div>
<div><span class="muted">Scored comparisons</span><strong>{model.comparisons}</strong><small>Missing judgments are not losses</small></div>
<div><span class="muted">Valid conversations</span><strong>{model.valid} / {model.planned}</strong><small>Partner: {data.partner}</small></div>
</div>
<nav class="eq-section-nav" aria-label="Model sections"><a href="#summary">Summary</a><a href="#judges">Judge ratings</a><a href="#abilities">Abilities</a><a href="#style">Style</a><a href="#opponents">Opponents</a><a href="#conversations">Conversations</a></nav>
<section class="panel" id="summary"><h2>Model summary</h2><p class="badge">{ready ? 'Results complete · summary awaiting review' : 'Waiting for complete results'}</p><p>{ready ? 'All planned results are in. A reviewed summary of strengths and weaknesses can now be written.' : 'A strengths-and-weaknesses summary will be added after all planned conversations, pairwise judgments and trait assessments for this model are complete. The charts below show the evidence available so far.'}</p>
{completion && <ul class="summary-coverage">{([['conversations','Conversations'],['judgments','Pairwise judgments'],['traits','Trait assessments']] as const).map(([key,label])=><li><strong>{completion[key].done} / {completion[key].planned}</strong><span>{label}</span></li>)}</ul>}
<p class="footnote">Pairwise completion requires every assigned judge in both presentation orders, including comparisons waiting for other models. A failed or missing result does not count as complete. Later additions to the plan can reopen this requirement.</p></section>
<section class="panel" id="judges"><h2>Where each judge places this model</h2><p>Each dot is a model rated by that judge. The highlighted dot is {model.name}. Both charts use the same scale; rows within a chart only separate overlapping dots.</p><p class="footnote">Focus or hover a dot for its model and rating; select it to open that model. Expand the list for exact values. These are partial results, and judges may rank models differently.</p>
{plots.map(({judge,points})=><div class="judge-plot"><div class="metric-heading"><h3>{judge.model}</h3><strong>{model.per_judge[judge.id]?.toFixed(1) ?? 'Not rated'}</strong></div><p class="muted">{judge.effort} effort · {points.length} rated models</p>
{points.length ? <><div class="rating-strip" role="group" aria-label={`${judge.model} model ratings`}>{points.map((p,i)=><a href={`/eq/models/${p.id}/#judges`} class={`rating-dot ${p.id===model.id ? 'current' : ''}`} style={`left:${pos(p.value)}%;top:${12+(i%4)*16}px`} title={`${p.name}: ${p.value.toFixed(1)}`} aria-label={`${p.name}: ${p.value.toFixed(1)}${p.id===model.id ? ' (current model)' : ''}`}></a>)}</div><div class="metric-scale"><span>{low}</span><span>{(low+high)/2}</span><span>{high}</span></div><details><summary>All {points.length} ratings</summary><ul class="rating-list">{[...points].reverse().map(p=><li><a href={`/eq/models/${p.id}/`} aria-current={p.id===model.id ? 'page' : undefined}>{p.name}</a><strong>{p.value.toFixed(1)}</strong></li>)}</ul></details></> : <p>No ratings from this judge yet.</p>}</div>)}
<p class="footnote">{data.anchored ? 'Ratings are approximately mapped to the EQ-Bench scale using anchors.' : 'Ratings are on the raw Bradley–Terry scale.'} These dot plots do not show uncertainty; the combined rating interval is above.</p></section>
<section class="panel" id="abilities"><h2>Abilities</h2><p>Higher means stronger relative performance in these pairwise judgments. Scores are rescaled from 1 to 10 within this field; 10 does not mean perfect performance.</p><p class="profile-status">{ready ? 'All planned assessments complete.' : 'Provisional profile · judgments are still arriving.'}</p><Radar id="ability-radar" title="Ability profile" axes={abilityAxes} minimum={1} {...radarData(abilityAxes)}/><p class="footnote">The comparison mean gives each scored model equal weight, includes this model and excludes missing values. Models may cover different personas. Chart differences are descriptive; they do not establish statistical significance.</p><details class="profile-details"><summary>Exact ability scores, averages and definitions</summary><p class="chart-key">Filled bar: this model · vertical marker: scored-model mean</p><div class="metric-grid">{data.dimensions.map(d=><Metric label={labels[d] ?? d} value={model.abilities[d]} values={data.models.map(m=>m.abilities[d]).filter((v):v is number=>v!=null)} description={def(d)}/>)}</div></details></section>
<section class="panel" id="style"><h2>Conversational style</h2><p class="notice"><strong>Higher means more of the tendency, not better performance.</strong> For example, a high “Yields under pressure” score means the model more readily backs off or softens its position when pressed. These traits do not affect the overall rating.</p><p>{model.traits_valid ?? 0} / {model.traits_planned ?? model.planned*data.judges.length} trait assessments completed. Profiles may change as more conversations are judged.</p><div class="radar-grid-layout">{groups.map((g,i)=>{const axes=g.traits.map(([key,label])=>({key,label,shortLabel:shortLabels[key] ?? [label]}));return <Radar id={`trait-radar-${i}`} title={g.name} axes={axes} minimum={0} {...radarData(axes,true)}/>})}</div><p class="footnote">Trait scales run from 0 (less) to 10 (more). A larger shape is not a better score. Naturalness uses the full “Naturalness and authenticity” dimension; frame adaptation means “Adapts to the person’s frame.”</p><details class="profile-details"><summary>Exact trait scores, uncertainty and definitions</summary><p class="chart-key">Filled bar: this model · vertical marker: scored-model mean · thin line: this model’s 95% interval</p>
{groups.map(g=><div><h3>{g.name}</h3><div class="metric-grid">{g.traits.map(([key,label])=>{const t=model.traits?.[key];return <Metric label={label} value={t?.mean} ci={t?.ci} count={t?.conversations} values={data.models.flatMap(m=>m.traits?.[key] ? [m.traits[key].mean] : [])} description={def(key)} styleTrait/>})}</div></div>)}
</details><p class="footnote">The mean weights each scored model equally, includes this model, and excludes missing scores. Models may have different persona coverage. Differences from the mean are descriptive, not significance tests or quality grades. Trait intervals resample conversations.</p></section>
<section class="panel" id="opponents"><h2>Record against opponents</h2><p>Each bar shows this model’s share of wins, ties and losses against an opponent. Counts include both orders and all judges; they are not independent conversations.</p><p class="record-key"><span>● Wins</span><span>● Ties</span><span>● Losses</span></p>{opponents.map(([id,r])=>{const total=r.won+r.tied+r.lost;return <div class="opponent"><div class="metric-heading"><a href={`/eq/models/${id}/`}>{data.models.find(m=>m.id===id)?.name ?? id}</a><span>{total} judgments</span></div><div class="record-track" role="img" aria-label={`${r.won} wins, ${r.tied} ties, ${r.lost} losses`}><span class="wins" style={`width:${total ? 100*r.won/total : 0}%`}></span><span class="ties" style={`width:${total ? 100*r.tied/total : 0}%`}></span><span class="losses" style={`width:${total ? 100*r.lost/total : 0}%`}></span></div><p class="metric-context">{r.won} wins · {r.tied} ties · {r.lost} losses</p></div>})}{!opponents.length && <p>No valid judgments yet.</p>}</section>
<section class="panel" id="conversations"><h2>Read the conversations</h2><p>Inspect the exchanges behind these scores. <a href="/eq/personas/">Browse persona instructions and openings</a>.</p><ul class="conversation-list">{conversations.map(c=><li><a href={`/eq/conversations/${c.id}/`}>{c.scenario}</a><span class="badge">{c.status.replaceAll('_',' ')}</span></li>)}</ul>{!conversations.length && <p>No conversations yet.</p>}</section>
</Frame>
