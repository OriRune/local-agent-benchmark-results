---
import Frame from '../../components/eq/Frame.astro';
import { data } from '../../data/eq-data';
import definitions from '../../data/eq-definitions.json';
const labels:Record<string,string>={bond_and_rapport:'Rapport',authenticity:'Authenticity',attunement:'Attunement',meeting_prefs_and_needs:'Needs',emotion_sensemaking:'Sensemaking',emotion_management:'Management'};
const updated=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit',timeZone:'UTC'}).format(new Date(data.updated))+' UTC';
const state=(m:typeof data.models[number])=>m.completion?.summary_status==='ready_for_summary' ? 'complete' : m.comparisons>=4 ? 'provisional' : 'waiting';
const statusLabels={complete:'Results complete',provisional:'Provisional rating',waiting:'Awaiting judgments'};
const fmt=(n:number|null)=>n==null ? '—' : n.toFixed(1);
---
<Frame><header class="eq-overview-heading"><h1>EQ Lab</h1><p>How local and cloud models handle emotionally complex conversations.</p></header>
<div class="run-strip"><span><strong>{data.models.length}</strong> models</span><span><strong>{data.personas}</strong> personas</span><span><strong>{data.conversations_done}/{data.conversations_planned}</strong> conversations</span><span><strong>{data.comparisons_scored}/{data.comparisons_planned}</strong> comparisons</span><span class="muted">Updated {updated}</span></div>
<p class="footnote">Independent experiment, not official EQ-Bench scores. Partner: {data.partner}. <a href="/eq/about/">Method & limitations</a></p>
<div class="overview-tools"><label>Find a model <input type="search" data-model-search placeholder="Name or quantization"/></label><div class="status-key">{Object.entries(statusLabels).map(([s,label])=><span><i class={`status-dot ${s}`} aria-hidden="true"></i>{label}</span>)}</div></div>
<p class="chart-key">Ability heatmap · 1–10, lower <span class="heat-key" aria-hidden="true"></span> higher relative performance. Missing scores are —. Select a column to sort.</p>
<div class="table-scroll" role="region" aria-label="Leaderboard"><table class="board leaderboard compact-board" data-table-label="Leaderboard"><caption class="sr-only">Model ratings and six ability scores</caption><thead><tr><th data-type="number">#</th><th>Model</th><th data-type="number">Rating</th>{data.dimensions.map(d=><th data-type="number" title={(definitions as Record<string,string>)[d]}>{labels[d]}</th>)}</tr></thead><tbody>{data.models.map((m,i)=>{
const ranked=m.comparisons>=4 && m.rating!=null;
return <tr data-search={m.name.toLowerCase()}><td data-sort={ranked ? i+1 : ''} class="rank-cell">{ranked ? i+1 : '—'}</td><td class="model-cell" data-sort={m.name}><div class="model-name"><i class={`status-dot ${state(m)}`} role="img" aria-label={statusLabels[state(m)]} title={`${statusLabels[state(m)]} · ${m.comparisons} comparisons · ${m.valid}/${m.planned} conversations`}></i><a href={`/eq/models/${m.id}/`}>{m.name}</a></div><small>{m.kind}{m.thinking==null ? '' : ` · thinking ${m.thinking ? 'on' : 'off'}`}</small></td><td class="rating-cell" data-label="Rating" data-sort={ranked ? m.rating! : ''}><strong>{ranked ? fmt(m.rating) : 'Pending'}</strong><small>{m.ci ? `95% interval ${m.ci.map(fmt).join('–')}` : 'Awaiting evidence'}</small><small>{data.judges.map(j=>`${j.client==='codex' ? 'Sol' : 'Opus'} ${fmt(m.per_judge[j.id])}`).join(' · ')}</small></td>{data.dimensions.map(d=>{const v=m.abilities[d];return <td class="heat-cell" data-label={labels[d]} data-sort={v ?? ''}><span class="heat-value" style={v==null ? '' : `--heat:${Math.round(5+v*3)}%`} title={`${labels[d]}: ${v==null ? 'not scored' : v.toFixed(1)+' / 10'}`}>{v==null ? '—' : v.toFixed(1)}</span></td>})}</tr>})}</tbody></table></div>
<p data-filter-empty hidden>No models match that search.</p>
<details class="heat-definitions"><summary>What do the abilities mean?</summary><dl>{data.dimensions.map(d=><div><dt>{labels[d]}</dt><dd>{(definitions as Record<string,string>)[d]}</dd></div>)}</dl></details>
<p class="footnote">Abilities are rescaled within this field; 10 does not mean perfect. Rows with fewer than four comparisons are pending. Ratings and intervals remain provisional as judgments arrive; missing judgments are not losses. {data.anchored ? 'Ratings are approximately mapped to the EQ-Bench scale using anchors.' : 'Ratings use the raw Bradley–Terry scale.'} Open a model for the full evidence.</p>
</Frame>
