---
import Frame from '../../components/eq/Frame.astro';
import { data } from '../../data/eq-data';
const fmt = (n: number | null) => n == null ? '—' : n.toFixed(1);
const values = data.models.flatMap(m => [m.rating, m.anchor, ...(m.ci || [])]).filter((n): n is number => n != null);
const low = Math.min(800,...values)-50, high = Math.max(1400,...values)+50;
const pos = (n: number) => Math.max(0,Math.min(100,100*(n-low)/(high-low)));
---
<Frame><h1>EQ Lab</h1><p class="lede">How local and cloud models handle conversations with simulated people.</p><p class="notice">Independent results. EQ Lab is not affiliated with or endorsed by EQ-Bench. These ratings are not EQ-Bench scores; different partners and judges make them only approximately comparable.</p><section class="panel"><h2>Run in progress</h2><p>{data.conversations_done} / {data.conversations_planned} valid conversations · {data.comparisons_scored} / {data.comparisons_planned} comparisons scored</p><p class="muted">Partner: {data.partner} · Updated {data.updated}. Missing judgments are not losses.</p></section><h2>Leaderboard</h2><p class="muted">Rows with at least four comparisons are ordered by rating; others are in progress. Abilities are relative to the models here, from 1 to 10. The marker shows the official EQ-Bench Elo for anchors.</p><div class="table-scroll"><table class="board"><thead><tr><th>Rank</th><th>Model</th><th>Rating · 95% interval</th>{data.judges.map(j=><th>{j.model}<br/><small>{j.effort}</small></th>)}{data.dimensions.map(d=><th>{d.replaceAll('_',' ')}</th>)}<th>Coverage</th></tr></thead><tbody>{data.models.map((m,i)=><tr><td>{m.comparisons >= 4 && m.rating != null ? i+1 : '—'}</td><td><a href={`/eq/models/${m.id}/`}>{m.name}</a><br/><span class="badge">{m.kind}</span></td><td>{m.comparisons >= 4 ? fmt(m.rating) : 'In progress'}{(m.ci || m.anchor != null) && <div class="rankbar" title={`95% interval ${m.ci ? m.ci.join("–") : "not available"}; EQ-Bench Elo ${m.anchor ?? 'not available'}`}>{m.ci && <span class="interval" style={`left:${pos(Math.min(...m.ci))}%;width:${pos(Math.max(...m.ci))-pos(Math.min(...m.ci))}%`}></span>}{m.anchor != null && <span class="tick" style={`left:${pos(m.anchor)}%`}></span>}</div>}</td>{data.judges.map(j=><td>{fmt((m.per_judge as Record<string, number | null>)[j.id])}</td>)}{data.dimensions.map(d=>{const v=(m.abilities as Record<string, number>)[d];return <td><span class="ability" title={`${d.replaceAll('_',' ')}: ${v ?? 'not rated'} of 10`} style={v == null ? '' : `background:color-mix(in srgb, var(--accent) ${Math.round(v*6)}%, var(--paper))`}>{v ?? '—'}</span></td>})}<td>{m.comparisons} comparisons<br/><small>{m.valid}/{m.planned} conversations</small></td></tr>)}</tbody></table></div><p class="footnote">{data.anchored ? 'Ratings are mapped to the EQ-Bench scale using anchor models.' : 'Fewer than two usable anchors: ratings are on the raw Bradley–Terry scale.'} Intervals are bootstrap estimates. <a href="/eq/about/">Read the method</a>.</p></Frame>
