---
import Frame from '../../../components/eq/Frame.astro';
import { data } from '../../../data/eq-data';
---
<Frame title="Conversation transcripts"><h1>Conversation transcripts</h1><p class="lede">Read model conversations, grouped by the {data.personas} simulated people they spoke with.</p><p class="footnote">Summaries describe the fictional persona, including background hidden from the tested model. They are AI-written and checked against the source cards. The model receives only its own instructions and the opening message; full prompts are available below.</p>
<details class="persona-directory"><summary>Jump to a persona ({data.personas})</summary><nav class="persona-index" aria-label="Jump to persona">{data.persona_cards.map(p=><a href={`#${p.id}`}>{p.title}</a>)}</nav></details>
{data.persona_cards.map(p=><section class="panel persona-card" id={p.id}><span class="badge">{p.category_label}</span><h2>{p.title}</h2><p class="category-context">{p.category_description}</p><div class="persona-intro"><div><h3>The person</h3><p>{p.summary ?? 'See the full persona instructions below.'}</p><p class="footnote">Model’s assigned relationship: {p.relationship.replaceAll('_',' ')}</p></div><div><h3>Opening message</h3><blockquote class="prompt-text">{p.opening}</blockquote></div></div><details><summary>Tested model's initial instructions</summary><pre>{p.tested_prompt}</pre></details><details><summary>Simulated person's instructions (hidden from the tested model)</summary><pre>{p.persona_prompt}</pre></details><details class="persona-conversations"><summary>Read conversations with this persona ({data.conversations.filter(c=>c.scenario_id===p.id).length})</summary><ul>{data.conversations.filter(c=>c.scenario_id===p.id).map(c=><li><a href={`/eq/conversations/${c.id}/`}>{data.models.find(m=>m.id===c.model)?.name ?? c.model}</a> · {c.status.replaceAll('_',' ')}</li>)}</ul></details></section>)}</Frame>
